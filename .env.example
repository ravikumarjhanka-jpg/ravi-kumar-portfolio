# Copy to .env (never commit .env). All values are optional.

# Final public domain, e.g. https://ravikumar.in. Enables canonical URL, absolute OG image and sitemap.xml.
VITE_SITE_URL=

# Saved contact messages (Supabase). Use the PUBLIC anon key only, never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server endpoint for LLM answers in Ask Ravi: POST {"question","context"} -> {"answer"}.
# Keep any LLM API key on that server. Never put API keys in frontend code.
VITE_ASK_ENDPOINT=
